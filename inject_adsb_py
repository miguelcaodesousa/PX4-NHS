
import asyncio
from mavsdk import System
from mavsdk.mavlink import MavlinkMessage
from pymavlink.dialects.v20 import common as mavlink2

async def run():
    drone = System()
    await drone.connect(system_address="udp://:14540")

    print("Waiting for drone to connect...")
    async for state in drone.core.connection_state():
        if state.is_connected:
            print("Drone connected!")
            break

    # Create the ADSB_VEHICLE MAVLink message
    msg = mavlink2.MAVLink_adsb_vehicle_message(
        ICAO_address=70001,
        lat=int(53.4105 * 1e7),        # degrees * 1e7
        lon=int(-1.4458 * 1e7),
        alt=120 * 1000,                # mm
        heading=9000,                  # 90.00 deg * 100
        hor_velocity=2500,             # 25 m/s * 100
        ver_velocity=0,
        callsign="UAV70001    ",
        emitter_type=3,
        tslc=1,
        flags=1,  # valid coordinates
        squawk=1000,
        altitude_type=0
    )

    print("Sending ADS-B vehicle...")
    await drone.mavlink.send_message(MavlinkMessage(msg))

asyncio.run(run())
